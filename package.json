{
  "name": "gas-sheetdb",
  "version": "2.1.5",
  "private": true,
  "description": "Database-like storage layer for Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-sheetdb"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gas-dev-config/prettier",
  "gasDevConfig": {
    "loadOrder": [
      "gas-sheetdb.types.ts",
      "gas-sheetdb.errors.ts",
      "gas-sheetdb.constants.ts",
      "gas-sheetdb.codec.ts",
      "gas-sheetdb.schema.ts",
      "gas-sheetdb.table.ts",
      "gas-sheetdb.class.ts"
    ],
    "peers": {
      "gas-lock": "^1.2.0",
      "gas-error": "^1.2.0"
    },
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/script.storage"
      ]
    }
  },
  "gasDevRelease": {
    "githubRelease": true
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "gas-dev-config": "github:yorsh-co/gas-dev-config#semver:^2.2.0",
    "gas-dev-release": "github:yorsh-co/gas-dev-release#semver:^2.1.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gas-dev-release",
    "peers:sync": "gas-dev-config peers sync",
    "peers:check": "gas-dev-config peers sync --check",
    "build": "npm run clean && tsc",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:watch": "tsc --watch",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.peer.json && tsc -p gas-test/tsconfig.json --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gas-dev-config check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gas:build": "gas-dev-config gas-test build",
    "test:gas": "gas-dev-config gas-test run"
  }
}
