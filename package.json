{
  "name": "gas-sheetdb",
  "version": "2.0.0",
  "private": true,
  "description": "Database-like storage layer for Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-sheetdb"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "prettier": "gas-dev-config/prettier",
  "devDependencies": {
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "gas-dev-config": "github:yorsh-co/gas-dev-config#semver:^1.1.0",
    "gas-dev-release": "github:yorsh-co/gas-dev-release#semver:^1.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gas-dev-release",
    "build": "npm run clean && tsc",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:watch": "tsc --watch",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.peer.json && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gas-dev-config check",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
